# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="MLOps Observability Platform"
ENVIRONMENT=local
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mlops:mlops@postgres:5432/mlops_db
# true logs every SQL statement (very noisy)
SQL_ECHO=false

# ─── Rate limiting (requests per minute) ──────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PREDICT_PER_MINUTE=6000
RATE_LIMIT_JOBS_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=600

# ─── Training ─────────────────────────────────────────────────────────────────
# CPU threads per model; "all cores" made XGBoost ~150x slower in Docker
TRAINING_THREADS_PER_MODEL=4

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── MinIO (local S3 replacement) ─────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DATASETS=mlops-datasets
S3_BUCKET_MODELS=mlops-models
S3_REGION=us-east-1

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-256bit-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Drift Detection ──────────────────────────────────────────────────────────
DRIFT_KS_P_VALUE_THRESHOLD=0.05
DRIFT_MIN_EFFECT=0.1
# Beat ticks this often; each production model is checked when its SLA-tier interval elapses
DRIFT_CHECK_INTERVAL_SECONDS=60
DRIFT_INTERVAL_CRITICAL=60
DRIFT_INTERVAL_STANDARD=300
DRIFT_INTERVAL_LOW=1800
DRIFT_WINDOW_MINUTES=60
DRIFT_MIN_SAMPLES=50
ENABLE_FAULT_INJECTION=true

# ─── Alerting (leave blank to disable) ───────────────────────────────────────
SLACK_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=30
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
