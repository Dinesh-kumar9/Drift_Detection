# Set default behaviour to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files to use LF
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.tf    text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.mako  text eol=lf
*.html  text eol=lf
*.svg   text eol=lf

# Binary files — do not modify
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
